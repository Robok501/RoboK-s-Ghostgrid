{
  "expo": {
    "name": "Ghostgrid",
    "slug": "ghostgrid",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.robok.ghostgrid",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ghostgrid listens for your hits to score your timing against the click.",
        "NSBluetoothAlwaysUsageDescription": "Ghostgrid connects to Bluetooth MIDI drum modules, such as your e-drum.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.robok.ghostgrid",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1214"
      }
    },
    "icon": "./assets/icon.png",
    "locales": {
      "en": "./locales/en.json",
      "nl": "./locales/nl.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    },
    "experiments": {
      "baseUrl": "/RoboK-s-Ghostgrid"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
